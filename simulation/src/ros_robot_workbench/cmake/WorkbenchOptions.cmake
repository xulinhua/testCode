# Kit-level switches (control compile + UI registration)
option(WORKBENCH_KIT_GENERAL "Build General kit modules" ON)
option(WORKBENCH_KIT_KINEMATICS "Build Kinematics kit modules" ON)
option(WORKBENCH_KIT_CALIBRATION "Build Calibration kit modules" ON)
option(WORKBENCH_KIT_ARM "Build Arm kit modules" ON)
option(WORKBENCH_KIT_MOBILE "Build Mobile robot kit modules" ON)
option(WORKBENCH_KIT_LEGGED "Build Legged robot kit modules" ON)
option(WORKBENCH_KIT_HUMANOID "Build Humanoid kit modules" ON)
option(WORKBENCH_KIT_PLANNING "Build Path planning kit modules" ON)
option(WORKBENCH_KIT_PERCEPTION3D "Build 3D perception kit modules" ON)
option(WORKBENCH_KIT_SIMULATION "Build Simulation kit modules" ON)
option(WORKBENCH_KIT_DL "Build Deep learning kit modules" ON)

# Capability switches (optional heavy dependencies)
option(WORKBENCH_WITH_MOVEIT "Build MoveIt-related code (moveit_msgs)" ON)
option(WORKBENCH_WITH_KDL "Build KDL/URDF kinematics" ON)
option(WORKBENCH_WITH_OPENCV "Build OpenCV-dependent calibration modules" ON)

set(WORKBENCH_PRESET "" CACHE STRING "Build preset: minimal, general, arm, or full")

if(WORKBENCH_PRESET STREQUAL "minimal")
  set(WORKBENCH_KIT_GENERAL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_KINEMATICS OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_CALIBRATION OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_ARM OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_MOBILE OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_LEGGED OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_HUMANOID OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PLANNING OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PERCEPTION3D OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_SIMULATION OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_DL OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_MOVEIT OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_KDL OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_OPENCV OFF CACHE BOOL "" FORCE)
  message(STATUS "WORKBENCH_PRESET=minimal (通用 Kit: 系统状态/话题/Rosbag/图像查看)")
elseif(WORKBENCH_PRESET STREQUAL "general")
  set(WORKBENCH_KIT_GENERAL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_KINEMATICS ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_CALIBRATION OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_ARM OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_MOBILE OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_LEGGED OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_HUMANOID OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PLANNING OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PERCEPTION3D OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_SIMULATION ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_DL OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_MOVEIT OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_KDL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_OPENCV OFF CACHE BOOL "" FORCE)
  message(STATUS "WORKBENCH_PRESET=general")
elseif(WORKBENCH_PRESET STREQUAL "arm")
  set(WORKBENCH_KIT_GENERAL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_KINEMATICS ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_CALIBRATION ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_ARM ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_MOBILE OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_LEGGED OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_HUMANOID OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PLANNING OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PERCEPTION3D OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_SIMULATION ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_DL OFF CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_MOVEIT ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_KDL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_OPENCV ON CACHE BOOL "" FORCE)
  message(STATUS "WORKBENCH_PRESET=arm")
elseif(WORKBENCH_PRESET STREQUAL "full")
  set(WORKBENCH_KIT_GENERAL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_KINEMATICS ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_CALIBRATION ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_ARM ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_MOBILE ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_LEGGED ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_HUMANOID ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PLANNING ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_PERCEPTION3D ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_SIMULATION ON CACHE BOOL "" FORCE)
  set(WORKBENCH_KIT_DL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_MOVEIT ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_KDL ON CACHE BOOL "" FORCE)
  set(WORKBENCH_WITH_OPENCV ON CACHE BOOL "" FORCE)
  message(STATUS "WORKBENCH_PRESET=full")
elseif(NOT WORKBENCH_PRESET STREQUAL "")
  message(WARNING "Unknown WORKBENCH_PRESET='${WORKBENCH_PRESET}', ignored")
endif()

# Auto-disable capability flags when dependency missing
if(WORKBENCH_WITH_MOVEIT)
  find_package(moveit_msgs QUIET)
  if(NOT moveit_msgs_FOUND)
    message(WARNING "moveit_msgs not found; disabling WORKBENCH_WITH_MOVEIT")
    set(WORKBENCH_WITH_MOVEIT OFF CACHE BOOL "" FORCE)
  endif()
endif()

if(WORKBENCH_WITH_KDL)
  find_package(urdf QUIET)
  find_package(kdl_parser QUIET)
  find_package(orocos_kdl QUIET)
  if(NOT urdf_FOUND OR NOT kdl_parser_FOUND OR NOT orocos_kdl_FOUND)
    message(WARNING "urdf/kdl_parser/orocos_kdl not found; disabling WORKBENCH_WITH_KDL")
    set(WORKBENCH_WITH_KDL OFF CACHE BOOL "" FORCE)
  endif()
endif()

if(WORKBENCH_WITH_OPENCV)
  find_package(OpenCV QUIET)
  if(NOT OpenCV_FOUND)
    message(WARNING "OpenCV not found; disabling WORKBENCH_WITH_OPENCV")
    set(WORKBENCH_WITH_OPENCV OFF CACHE BOOL "" FORCE)
  endif()
endif()

if(WORKBENCH_KIT_KINEMATICS AND NOT WORKBENCH_WITH_KDL)
  message(WARNING "WORKBENCH_KIT_KINEMATICS needs WORKBENCH_WITH_KDL; disabling kit")
  set(WORKBENCH_KIT_KINEMATICS OFF CACHE BOOL "" FORCE)
endif()

message(STATUS "ros_robot_workbench kits: GENERAL=${WORKBENCH_KIT_GENERAL} KINEMATICS=${WORKBENCH_KIT_KINEMATICS} "
  "CALIBRATION=${WORKBENCH_KIT_CALIBRATION} ARM=${WORKBENCH_KIT_ARM} MOBILE=${WORKBENCH_KIT_MOBILE} "
  "SIMULATION=${WORKBENCH_KIT_SIMULATION} DL=${WORKBENCH_KIT_DL}")
message(STATUS "ros_robot_workbench caps: MOVEIT=${WORKBENCH_WITH_MOVEIT} KDL=${WORKBENCH_WITH_KDL} OPENCV=${WORKBENCH_WITH_OPENCV}")
