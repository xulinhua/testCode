<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 引入D405相机模型 -->
  <xacro:include filename="$(find nova_sim)/urdf/sensor/camera/realsense/_d405.urdf.xacro"/>
  
  <!-- 定义深度相机宏 -->
  <xacro:macro name="depth_camera" params="parent *origin name:=camera use_nominal_extrinsics:=true">
    
    <!-- 使用D405相机宏 -->
    <xacro:sensor_d405 parent="${parent}" name="${name}" use_nominal_extrinsics="${use_nominal_extrinsics}">
      <xacro:insert_block name="origin"/>
    </xacro:sensor_d405>

    <!-- ========== RGB相机配置========== -->
    <gazebo reference="${name}_link">
      <sensor type="camera" name="rgb_sensor">
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="rgb_sensor_plugin">
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ========== 深度相机配置========== -->
    <gazebo reference="${name}_link">
      <sensor type="depth" name="${name}_depth_sensor">
        <update_rate>10.0</update_rate>
        <camera>
          <horizontal_fov>1.5009831567</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="depth_sensor_plugin">
          <frame_name>${name}_depth_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    
  </xacro:macro>

</robot>
