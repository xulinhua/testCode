<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="simple_world">

    <scene>
      <!-- Add soft global ambient light to reduce harsh local contrast. -->
      <ambient>0.45 0.45 0.45 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- 使用 Gazebo 内置模型（与 urdf_sim_tutorial 保持一致） -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 顶部补光：提升 ArUco 边缘对比度与清晰度 -->
    <light name="aruco_top_fill" type="spot">
      <cast_shadows>false</cast_shadows>
      <pose>0.23 -0.29 3.00 0.0 0.0 0.0</pose>
      <diffuse>0.72 0.72 0.72 1.0</diffuse>
      <specular>0.01 0.01 0.01 1.0</specular>
      <attenuation>
        <range>10.0</range>
        <constant>0.95</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>1.0</inner_angle>
        <outer_angle>1.45</outer_angle>
        <falloff>0.35</falloff>
      </spot>
    </light>

    <!-- 物理引擎配置：略降仿真步频、加强求解与接触层，减轻网格碰撞引起的高频抖 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <!-- 极小 CFM 略软化约束，常能减轻接触高频振颤 -->
          <cfm>0.000000001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0015</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>
