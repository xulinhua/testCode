)
{
}

over "J1_8" (
    prepend apiSchemas = ["PhysxRigidBodyAPI"]
)
{
    string isaac:nameOverride (
        displayName = "Name Override"
        doc = "Name override for prim lookup in base name search"
    )
    vector3f physics:angularVelocity = (4.2821984e18, 2.393158e18, 3.8582352e18)
    rel physics:simulationOwner
    vector3f physics:velocity = (9.83656e15, -1.0570057e16, -767709630000000)
    float physxRigidBody:maxLinearVelocity = 1000
    quatd xformOp:orient = (0.0000027858387808298383, 8.068496013902394e-10, 0.7071055294852402, 0.7071080328801516)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0.32005090529569213, -0.19925171085481272, 0.3548183733742541)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    over "visuals" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI", "PhysxConvexHullCollisionAPI"]
    )
    {
        uniform token physics:approximation = "convexHull"
        bool physics:collisionEnabled = 1
        rel physics:simulationOwner
    }

    over "collisions" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI", "PhysxConvexHullCollisionAPI"]
    )
    {
        uniform token physics:approximation = "convexHull"
        bool physics:collisionEnabled = 1
        rel physics:simulationOwner
    }
}

