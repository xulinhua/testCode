<?xml version="1.0"?>
<sdf version="1.6">
  <model name="top_camera_mount">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 1</ambient>
          <diffuse>0.8 0.8 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.15</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_contacts>10</max_contacts>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.2</restitution_coefficient>
          </bounce>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <sensor name="top_camera" type="depth">
        <pose>0 0 0.05 0 0 0</pose>
        <camera name="top_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <output>depth</output>
          </depth_camera>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="top_camera_controller">
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>