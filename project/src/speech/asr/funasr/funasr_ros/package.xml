<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>funasr_ros</name>
  <version>1.0.0</version>
  <description>FunASR ROS wrapper for speech recognition</description>
  <maintainer email="chenwang@hoson.com">chenwang</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>audio_common_msgs</depend>
  <depend>std_msgs</depend>
  <depend>funasr_py</depend>
  <depend>audio_basic_py</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>